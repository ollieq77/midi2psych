# =========================
# Build outputs (your system)
# =========================
dist/build/
dist/release/
dist/zips/

# Executables (just in case anything leaks outside dist)
*.exe

# =========================
# Build artifacts (MinGW / GCC)
# =========================
*.o
*.obj
*.a
*.lib
*.dll

# Debug files
*.pdb
*.dSYM/

# =========================
# VS Code
# =========================
.vscode/*.log
.vscode/ipch/
.vscode/*.db
.vscode/*.sqlite

# Keep settings/tasks/launch (IMPORTANT)
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

# =========================
# Temporary files
# =========================
*.tmp
*.log

# =========================
# Optional backup files
# =========================
*~
*.bak

# =========================
# If you ever use CMake (future-proofing)
# =========================
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile